default-timeout=5000
width=380
height=200
padding=12
border-size=2
border-radius=3
font=Hasklug Nerd Font 12
icons=1
max-icon-size=48
icon-location=left
markup=1
layer=overlay
anchor=top-right
background-color=#000000
border-color=#ffffff
border-size=1
text-color=#ffffff
margin=12
max-visible=5
sort=+time
on-button-left=invoke-default-action
on-button-right=dismiss

[app-name=Volume]
group-by=app-name
history=0
anchor=bottom-center
padding=16
outer-margin=0,0,80,0
border-radius=3
format=<b>%s</b>\n%b

[app-name=Brightness]
group-by=app-name
history=0
anchor=bottom-center
padding=16
outer-margin=0,0,80,0
border-radius=3
format=<b>%s</b>\n%b

[app-name="spotify-player"]
max-icon-size=128

[app-name="Music Player"]
text-alignment=center
ignore-timeout=1
margin=10
layer=overlay

# Critical
[urgency=critical]
border-color=#F38BA8
background-color=#1E1E2E
text-color=#CDD6F4
default-timeout=0
layer=overlay

# Hidden
[hidden=true]
invisible=1
