#!/bin/sh
# Qt settings tools must not inherit a stale QT_STYLE_OVERRIDE from an
# already-running session; qt5ct/qt6ct refuse to work while it is set.
#
# This wrapper lives in ~/.local/bin, which comes before /usr/bin in PATH, so
# it must exec the real binary by path.
exec env -u QT_STYLE_OVERRIDE QT_QPA_PLATFORMTHEME=qt5ct /usr/bin/qt6ct "$@"
