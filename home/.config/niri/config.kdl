include "environment.kdl"

blur {
    off
}
include "input.kdl"
include "appearance.kdl"
include "layout.kdl"
include "autostart.kdl"
include "keybinds.kdl"
include "rules.kdl"

include "outputs.kdl" optional=true

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}
