# Simple mako config: dark bg, white text, white border, red critical border

font=Liga SFMono Nerd Font Medium 12
background-color=#06050c
text-color=#ffffff
border-color=#ffffff
border-size=1
border-radius=0
width=400
height=100
margin=16
padding=16
anchor=top-right
layer=overlay
max-visible=5
default-timeout=5000
markup=1
actions=1
progress-color=over #ffffff
icons=1
max-icon-size=48
icon-location=left
format=<b>%s</b>\n%b

[urgency=low]
default-timeout=10000

[urgency=critical]
border-color=#ff0000
border-size=2
default-timeout=0