general {
        colors = true
        interval = 5
}

order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "volume master"
order += "tztime local"

ethernet _first_ {
        format_up = "E: (%speed)"
        format_down = ""
}

disk "/" {
        format = "%avail"
}

memory {
        format = "%used"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

volume master {
        format = "%volume"
        format_muted = "muted"
        device = "pulse"
}

tztime local {
        format = "%d-%m-%Y %H:%M "
}
