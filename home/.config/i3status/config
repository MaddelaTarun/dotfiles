general {
    colors = true
    interval = 5
    color_good = "#83a994"
    color_degraded = "#cba98f"
    color_bad = "#d18f85"
}

order += "ethernet _first_"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

ethernet _first_ {
    format_up = "eth %ip"
    format_down = "eth down"
}

disk "/" {
    format = "disk %avail free"
}

load {
    format = "load %1min"
}

memory {
    format = "mem %used"
}

tztime local {
    format = "%a %d %b  %H:%M"
}
